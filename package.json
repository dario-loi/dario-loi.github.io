{
  "name": "dario-loi.github.io",
  "private": true,
  "type": "module",
  "description": "Personal academic site of Dario Loi, built with Astro and the Polytope design system.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "design:check": "polytope-design --check",
    "papers:check": "node scripts/papers.mjs check",
    "papers:sync": "node scripts/papers.mjs sync",
    "papers:meta": "node scripts/papers.mjs meta",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@dario-loi/polytope": "^0.8.0",
    "astro": "^7.4.12",
    "katex": "^0.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "pagefind": "^1.6.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.0",
    "yaml": "^2.9.1"
  }
}
