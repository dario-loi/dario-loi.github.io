---
import { linkPeople } from "../data/people";
import Base from "../layouts/Base.astro";
import Atlas from "@dario-loi/polytope/astro/Atlas.astro";
import AtlasStop from "@dario-loi/polytope/astro/AtlasStop.astro";
import MastTitle from "@dario-loi/polytope/astro/MastTitle.astro";
import PubList from "@dario-loi/polytope/astro/PubList.astro";
import CvLink from "../components/CvLink.astro";
import SectionHead from "../components/SectionHead.astro";
import { entries, pubRow } from "../lib/content";
import EmailLink from "../components/EmailLink.astro";
import { awards, cvAnchor, cvEntries, service, skills } from "../data/cv";
import { cv, person } from "../site";

const pubs = (await entries("publications")).map(pubRow);
---
<Base title="CV" description={`Curriculum vitae of ${person.name}, ${person.role} at ${person.affiliation}: education and research, with a map of where each happened.`} current="CV" profile crumbs={[{ name: person.name, href: "/" }, { name: "CV", href: "/cv/" }]}>
  <div class="ply-container cv-atlas">
    <Atlas label="Where the work has taken me" quiet>
      <Fragment slot="head">
        <MastTitle title="Curriculum vitae" />
        <p class="ply-mast__lede">{person.role} at {person.affiliation}.</p>
        <div class="ply-cluster cv-actions">
          {cv.pdf && <CvLink placement="cv-head" mode="download" variant="primary"><Fragment slot="download">Full CV as PDF</Fragment></CvLink>}
          <EmailLink placement="cv-head" variant={cv.pdf ? "ghost" : "primary"} />
        </div>
      </Fragment>
      {cvEntries.map((e) => (
        <AtlasStop id={cvAnchor(e)} level={2} title={e.title} org={e.org} kind={e.draft ? `${e.kind} (draft)` : e.kind} place={e.place} lat={e.lat} lon={e.lon} from={e.from} to={e.to}>
          {e.text && <p set:html={linkPeople(e.text)} />}
          {e.href && <p><a href={e.href} data-track="open-program" data-track-placement="cv" data-track-label={e.title}>{e.kind === "Education" && /^(Ph\.D\.|M\.S\.|B\.S\.)/.test(e.title) ? "Program page" : "Event page"}</a></p>}
        </AtlasStop>
      ))}
    </Atlas>
    <section class="cv-block cv-block--first" aria-labelledby="cv-awards-h">
      <SectionHead id="cv-awards-h" title="Honors and awards" fragment="awards" />
      <ul class="cv-awards" role="list">
        {awards.map((a) => <li><span>{a.text}</span><span class="cv-awards__year">{a.year}</span></li>)}
      </ul>
    </section>
    <section class="cv-block" aria-labelledby="cv-service-h">
      <SectionHead id="cv-service-h" title="Service" fragment="service" />
      <dl class="cv-skills">
        <div><dt>Reviewer</dt><dd><ul class="cv-skills__chips" role="list">{service.reviewer.map((v) => <li>{v}</li>)}</ul></dd></div>
      </dl>
      <ul class="cv-awards cv-service" role="list">
        {service.roles.map((r) => <li><span>{r.role}, {r.org}</span><span class="cv-awards__year">{r.years}</span></li>)}
      </ul>
    </section>
    <section class="cv-block" aria-labelledby="cv-skills-h">
      <SectionHead id="cv-skills-h" title="Skills" fragment="skills" />
      <dl class="cv-skills">
        {skills.map((g) => <div><dt>{g.name}</dt><dd><ul class="cv-skills__chips" role="list">{g.items.map((it) => <li>{it}</li>)}</ul></dd></div>)}
      </dl>
    </section>
    {pubs.length > 0 && (
      <section class="cv-pubs" aria-labelledby="cv-pubs-h">
        <SectionHead id="cv-pubs-h" title="Publications" fragment="publications" more={{ label: "All publications", href: "/publications/" }} />
        <PubList pubs={pubs} me={person.name} label={false} fold={12} />
      </section>
    )}
  </div>
</Base>
<style>
  .cv-atlas { padding-block-start: var(--ply-space-6); }
  .cv-actions { margin-top: var(--ply-space-5); }
  .cv-pubs, .cv-block { margin-top: var(--ply-space-6); }
  /* Stacked, the pinned globe closes on its own 3px rule, so the first section after it drops
     its rule: two bars in a row read as a mistake. */
  @media (max-width: 54rem) { .cv-block--first > :global(.sec-rule) { display: none; } }
  .cv-awards { list-style: none; padding: 0; margin: 0; }
  .cv-awards li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--ply-space-1) var(--ply-space-5); padding-block: var(--ply-space-3); border-top: var(--ply-border-hair) solid var(--ply-color-rule); }
  .cv-awards li:last-child { border-bottom: var(--ply-border-hair) solid var(--ply-color-rule); }
  .cv-awards li > span:first-child { flex: 1 1 24rem; min-width: 0; max-width: var(--ply-layout-measure); text-wrap: pretty; }
  .cv-awards__year { color: var(--cv-gold); font-weight: var(--ply-weight-bold); font-variant-numeric: tabular-nums; }
  .cv-service { margin-top: var(--ply-space-4); }
  .cv-skills { margin: 0; display: grid; gap: var(--ply-space-4); }
  .cv-skills > div { display: grid; gap: var(--ply-space-2); align-items: baseline; }
  .cv-skills dt { margin: 0; color: var(--ply-color-link); font-size: var(--ply-size-xs); font-weight: var(--ply-weight-bold); letter-spacing: 0.06em; text-transform: uppercase; }
  .cv-skills dd { margin: 0; min-width: 0; }
  .cv-skills__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--ply-space-2); max-width: var(--ply-layout-measure); }
  .cv-skills__chips li { padding: 0.15rem 0.55rem; background: var(--ply-color-surface-sunken); border: var(--ply-border-hair) solid var(--ply-color-rule); font-family: var(--ply-font-mono); font-size: var(--ply-size-sm); overflow-wrap: anywhere; }
  @media (min-width: 44rem) { .cv-skills > div { grid-template-columns: 11rem minmax(0, 1fr); gap: var(--ply-space-5); } }
  /* A stop's kind label takes the kind's color: Education teal, Experience tomato, Conference mustard. */
  .cv-atlas :global(.ply-atlas__stop[data-kind="Education"] .ply-label) { background: var(--cv-edu); color: var(--cv-on-edu); }
  .cv-atlas :global(.ply-atlas__stop[data-kind="Experience"] .ply-label) { background: var(--cv-exp); color: var(--cv-on-exp); }
  .cv-atlas :global(.ply-atlas__stop[data-kind="Conference"] .ply-label) { background: var(--ply-mustard-400); color: var(--ply-ink-950); }
  :root { --cv-gold: var(--ply-mustard-700); --cv-edu: var(--ply-teal-700); --cv-on-edu: #fff; --cv-exp: var(--ply-tomato-600); --cv-on-exp: #fff; }
  @media screen and (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --cv-gold: var(--ply-mustard-400); --cv-edu: var(--ply-teal-300); --cv-on-edu: var(--ply-ink-950); --cv-exp: var(--ply-tomato-400); --cv-on-exp: var(--ply-ink-950); }
  }
  :root[data-theme="dark"] { --cv-gold: var(--ply-mustard-400); --cv-edu: var(--ply-teal-300); --cv-on-edu: var(--ply-ink-950); --cv-exp: var(--ply-tomato-400); --cv-on-exp: var(--ply-ink-950); }
</style>
