---
import Base from "../../layouts/Base.astro";
import Empty from "@dario-loi/polytope/astro/Empty.astro";
import IndexMast from "../../components/IndexMast.astro";
import Card from "@dario-loi/polytope/astro/Card.astro";
import Cover from "../../components/Cover.astro";
import CardGrid from "@dario-loi/polytope/astro/CardGrid.astro";
import { cardPicture, entries, seedOf } from "../../lib/content";
import { projectsPage } from "../../lib/schema";
import { person } from "../../site";

const projects = await entries("projects");
const n = projects.length;
const description = `Software and research projects by ${person.name}.`;
---
<Base title="Projects" description={description} current="Projects" schema={[projectsPage(projects, description)]} crumbs={[{ name: person.name, href: "/" }, { name: "Projects", href: "/projects/" }]}>
  <IndexMast title="Projects" lede="Software and course projects." count={n > 0 ? `${n} ${n === 1 ? "project" : "projects"}` : undefined} />
  <div class="ply-container projects">
    {n === 0 ? (
      <Empty title="No projects listed yet" />
    ) : (
      <CardGrid>
        {projects.map((p, i) => (
          <Card
            href={`/projects/${p.id}/`}
            title={p.data.title}
            summary={p.data.description}
            meta={[String(p.data.date.getUTCFullYear()), ...(p.data.context ? [p.data.context] : [])]}
            tags={p.data.tags}
            level={2}
            lead={i === 0}
            badge={p.data.draft ? "Draft" : undefined}
            seed={seedOf(p.id)}
            link={{ "data-track": "open-project", "data-track-placement": "projects", "data-track-label": p.id }}
          >
            {p.data.cover && <Cover slot="figure" {...cardPicture(i === 0)} src={p.data.cover} dark={p.data.coverDark} alt="" />}
          </Card>
        ))}
      </CardGrid>
    )}
  </div>
</Base>
<style>
  .projects { padding-top: var(--ply-space-7); }
</style>
