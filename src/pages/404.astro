---
import Base from "../layouts/Base.astro";
import Empty from "@dario-loi/polytope/astro/Empty.astro";
import Button from "@dario-loi/polytope/astro/Button.astro";
---
<Base title="Page not found" noindex>
  <div class="ply-container lost">
    <Empty title="This page is not here" body="The address may be from the previous version of this site, or mistyped.">
      <div class="ply-cluster" style="justify-content: center">
        <Button href="/">Home</Button>
        <Button href="/publications/" variant="secondary">Publications</Button>
      </div>
    </Empty>
  </div>
</Base>
<style>
  .lost { padding-block: var(--ply-space-8); }
</style>
