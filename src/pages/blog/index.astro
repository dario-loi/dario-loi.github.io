---
import Base from "../../layouts/Base.astro";
import Empty from "@dario-loi/polytope/astro/Empty.astro";
import Button from "@dario-loi/polytope/astro/Button.astro";
import IndexMast from "../../components/IndexMast.astro";
import Card from "@dario-loi/polytope/astro/Card.astro";
import Cover from "../../components/Cover.astro";
import CardGrid from "@dario-loi/polytope/astro/CardGrid.astro";
import { cardPicture, entries, longDate, readingTime, seedOf } from "../../lib/content";
import { person } from "../../site";

const posts = await entries("blog");
const n = posts.length;
---
<Base title="Blog" description={`Writing by ${person.name} on research and engineering.`} current="Blog" noindex={n === 0} crumbs={[{ name: person.name, href: "/" }, { name: "Blog", href: "/blog/" }]}>
  <IndexMast title="Blog" lede="Notes on research and engineering." count={n > 0 ? `${n} ${n === 1 ? "post" : "posts"}` : undefined} />
  <div class="ply-container posts">
    {n === 0 ? (
      <Empty title="Nothing posted yet" body="Publications and projects are up in the meantime.">
        <div class="ply-cluster" style="justify-content: center">
          <Button href="/publications/">Publications</Button>
          <Button href="/projects/" variant="secondary">Projects</Button>
        </div>
      </Empty>
    ) : (
      <CardGrid>
        {posts.map((p, i) => (
          <Card
            href={`/blog/${p.id}/`}
            title={p.data.title}
            summary={p.data.description}
            meta={[longDate(p.data.date), `${readingTime(p.body)} min read`]}
            tags={p.data.tags}
            level={2}
            lead={i === 0}
            badge={p.data.draft ? "Draft" : undefined}
            seed={seedOf(p.id)}
            link={{ "data-track": "open-post", "data-track-placement": "blog", "data-track-label": p.id }}
          >
            {p.data.cover && <Cover slot="figure" {...cardPicture(i === 0)} src={p.data.cover} dark={p.data.coverDark} alt="" />}
          </Card>
        ))}
      </CardGrid>
    )}
  </div>
</Base>
<style>
  .posts { padding-top: var(--ply-space-7); }
</style>
