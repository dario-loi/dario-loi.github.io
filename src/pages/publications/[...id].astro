---
import type { GetStaticPaths } from "astro";
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Article from "@dario-loi/polytope/astro/Article.astro";
import PaperHeader from "@dario-loi/polytope/astro/PaperHeader.astro";
import Abstract from "@dario-loi/polytope/astro/Abstract.astro";
import BibTeX from "@dario-loi/polytope/astro/BibTeX.astro";
import Pager from "@dario-loi/polytope/astro/Pager.astro";
import Complex from "@dario-loi/polytope/astro/Complex.astro";
import Tex from "../../components/Tex.astro";
import { cardComplex, entries, neighbors, preview, pubVenue, seedOf } from "../../lib/content";
import { person } from "../../site";

export const getStaticPaths = (async () => {
  const pubs = await entries("publications");
  return pubs.map((pub) => ({ params: { id: pub.id }, props: { pub, ...neighbors(pubs, pub.id) } }));
}) satisfies GetStaticPaths;

interface Props { pub: CollectionEntry<"publications">; newer?: CollectionEntry<"publications">; older?: CollectionEntry<"publications"> }
const { pub, newer, older } = Astro.props;
const d = pub.data;
const { Content } = await render(pub);
const venueLine = pubVenue(d, true);
const links = [...d.links, { label: "BibTeX", href: "#cite", icon: "quote" as const }];
const seed = seedOf(pub.id);
const model = cardComplex(seed);
// Previews show the card's crop of the paper's figure, else the key figure itself.
const og = d.cover ? await preview(d.cover, d.coverAlt) : await preview(d.figure, d.figureAlt);
// Long BibTeX fields wrap rather than scroll, so the whole entry reads before it is copied. They
// hang under the column where the first field's value starts, or, on phones, just past the
// field names, which leaves the values more room.
const bibtex = d.bibtex.trim();
const field = bibtex.match(/^([ \t]*)\w+[ \t]*=[ \t]*\{?/m);
const hang = field?.[0].length ?? 2;
const hangNarrow = (field?.[1].length ?? 2) + 4;
---
<Base
  title={d.shortTitle ?? d.title}
  unnamed
  description={d.description ?? d.tldr ?? d.abstract.slice(0, 155)}
  current="Publications"
  noindex={d.draft}
  {...og}
  citation={{
    title: d.title,
    authors: d.authors,
    date: String(d.date.getUTCFullYear()),
    ...(d.kind === "journal" ? { journal: d.venueFull ?? d.venue } : d.kind === "preprint" ? {} : { conference: d.venueFull ?? d.venue }),
    pdf: d.pdf,
    doi: d.doi,
    arxiv: d.arxiv,
    abstract: d.abstract,
  }}
  crumbs={[{ name: person.name, href: "/" }, { name: "Publications", href: "/publications/" }, { name: d.title, href: `/publications/${pub.id}/` }]}
>
  <Article>
    <div slot="header" class:list={["paper-head", !d.figure && "paper-head--exhibit"]}>
      <PaperHeader title={d.title} venue={venueLine} authors={d.authors.map((name) => ({ name }))} me={person.name} links={links} />
      {/* The key figure leads the page, under the header and at its width. A paper without
          one hangs its card's image, or the complex seeded from its name, beside the header. */}
      {d.figure ? (
        <figure class:list={["ply-figure paper__figure", d.figureSize === "column" && "paper__figure--column"]}>
          {d.figureSize === "column"
            ? <Image src={d.figure} alt={d.figureAlt ?? ""} widths={[512, 1024]} sizes="(min-width: 36rem) 32rem, 100vw" />
            : <Image src={d.figure} alt={d.figureAlt ?? ""} widths={[640, 1040, d.figure.width]} sizes="(min-width: 64rem) 52rem, 100vw" />}
          {d.figureCaption && <figcaption><span class="ply-figure__num">Figure {d.figureNum}.</span><Tex text={d.figureCaption} html /></figcaption>}
        </figure>
      ) : (
        <figure class="ply-exhibit paper-head__exhibit">
          {d.cover ? (
            <div class="ply-panel ply-panel--flush" data-surface="panel"><Image src={d.cover} alt="" widths={[480, 960]} sizes="(min-width: 60rem) 22rem, (min-width: 32rem) 30rem, 100vw" /></div>
          ) : (
            <Complex seed={seed} points={model.points} radius={model.radius} label={`${d.title}: a complex drawn from the paper's name`} />
          )}
          {d.cover && <figcaption><b>{d.venue}.</b> {d.coverAlt}</figcaption>}
        </figure>
      )}
    </div>
    {d.tldr && <p class="paper__tldr"><span class="ply-label">In short</span> <Tex text={d.tldr} /></p>}
    <Abstract><p><Tex text={d.abstract} /></p></Abstract>
    {d.keywords.length > 0 && (
      <ul class="tag-list paper__keywords" role="list" aria-label="Keywords">{d.keywords.map((k) => <li class="ply-tag">{k}</li>)}</ul>
    )}
    <Content />
    <h2 id="cite" class="paper__cite">Cite</h2>
    <div id="bibtex" style={`--hang: ${hang}ch; --hang-narrow: ${hangNarrow}ch`}><BibTeX entry={bibtex} /></div>
  </Article>
  <div class="ply-container ply-article ply-article--head paper__foot">
    <div class="ply-article__main">
      <Pager
        label="More publications"
        prev={newer && { label: newer.data.title, href: `/publications/${newer.id}/` }}
        next={older && { label: older.data.title, href: `/publications/${older.id}/` }}
      />
    </div>
  </div>
</Base>
<script>
  // The BibTeX block's own Copy button reports that the entry was copied.
  for (const b of document.querySelectorAll<HTMLElement>("#bibtex .ply-code__copy")) {
    b.dataset.track = "bibtex-copy";
    b.dataset.trackPlacement = "paper-cite";
    b.dataset.trackLabel = location.pathname.split("/").filter(Boolean).pop() ?? "";
  }
  // Paper links (OpenReview, PDF, arXiv, Code) report which one was followed.
  for (const a of document.querySelectorAll<HTMLAnchorElement>(".paper-head .ply-paper__links a")) {
    if (a.getAttribute("href")?.startsWith("#")) continue;
    a.dataset.track = "paper-link";
    a.dataset.trackPlacement = "paper-header";
    a.dataset.trackLabel = a.textContent?.trim() ?? "";
  }
</script>
<style>
  /* Header and key figure share the head's width; the figure stops at 52rem, or near its
     printed size for a single-column figure, so raster parts are not enlarged. */
  .paper-head { display: grid; gap: 0 var(--ply-space-6); }
  .paper-head :global(.ply-paper) { padding-bottom: var(--ply-space-6); }
  .paper__figure { max-width: 52rem; margin-top: 0; margin-bottom: var(--ply-space-7); }
  .paper__figure--column { max-width: 32rem; }
  /* Without a key figure, the exhibit stacks under the header, then hangs in the margin
     column beside it once the article has one. */
  .paper-head__exhibit { margin-bottom: var(--ply-space-6); max-width: 30rem; }
  .paper-head__exhibit img { display: block; width: 100%; height: auto; }
  .paper-head__exhibit .ply-panel { outline: var(--ply-border-hair) solid var(--ply-color-rule); outline-offset: -1px; }
  @media (min-width: 60rem) {
    .paper-head--exhibit { grid-template-columns: minmax(0, var(--ply-layout-measure)) minmax(0, 1fr); align-items: center; }
    .paper-head--exhibit :global(.ply-paper) { padding-bottom: var(--ply-space-7); }
    .paper-head__exhibit { margin-block: var(--ply-space-7); }
  }
  .paper__tldr { font-size: var(--ply-size-lg); line-height: var(--ply-leading-normal); }
  .paper__tldr .ply-label { vertical-align: 0.2em; margin-inline-end: var(--ply-space-2); }
  .paper__cite { margin-top: var(--ply-space-8); }
  #bibtex :global(pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
  #bibtex :global(.line) { --_hang: var(--hang); display: inline-block; padding-inline-start: var(--_hang); text-indent: calc(-1 * var(--_hang)); }
  @media (max-width: 40rem) { #bibtex :global(.line) { --_hang: var(--hang-narrow); } }
  .paper__foot :global(.ply-pager) { max-width: var(--ply-layout-measure); margin-top: 0; }
</style>
