---
import Base from "../../../layouts/Base.astro";
import Mast from "@dario-loi/polytope/astro/Mast.astro";
import { entries, pubVenue } from "../../../lib/content";
import { topicPage } from "../../../lib/schema";
import { topicPath, topics } from "../../../data/topics";
import { person } from "../../../site";

const pubs = await entries("publications");
const rows = topics.map((topic) => ({ topic, pubs: pubs.filter((p) => p.data.topics.includes(topic.name)) })).filter((r) => r.pubs.length > 0);
const description = `Publications by ${person.name} grouped by research topic, including ${rows.slice(0, 6).map((r) => r.topic.name.toLowerCase().replace("llm", "LLM")).join(", ")}.`;
---
<Base
  kind="Topics"
  title="Research topics"
  description={description.length > 160 ? `${description.slice(0, 157)}...` : description}
  current="Publications"
  schema={[topicPage("/publications/topics/", `Research topics of ${person.name}`, description, pubs)]}
  crumbs={[{ name: person.name, href: "/" }, { name: "Publications", href: "/publications/" }, { name: "Topics", href: "/publications/topics/" }]}
>
  <Mast title="Topics" lede="The papers, grouped by what they are about." compact wideLede rule dense />
  <div class="ply-container">
    <ul class="ply-wall topic-wall" role="list">
      {rows.map(({ topic, pubs }) => (
        <li class="ply-wall__row">
          <div>
            <h2 class="ply-wall__name"><a href={topicPath(topic)} data-track="open-topic" data-track-placement="topics" data-track-label={topic.slug}>{topic.name}</a></h2>
          </div>
          <div class="ply-wall__body ply-wall__body--split">
            <p class="ply-wall__about">{topic.description}</p>
            <ul class="ply-wall__list" role="list">
              {pubs.map((p) => (
                <li><a href={`/publications/${p.id}/`} data-track="open-publication" data-track-placement="topics" data-track-label={p.id}>{p.data.shortTitle ?? p.data.title}</a> <span class="ply-wall__aside">{pubVenue(p.data)}</span></li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .topic-wall { padding-top: var(--ply-space-5); }
  .topic-wall :global(.ply-wall__row:first-child) { padding-top: 0; }
  /* The longest name fits the label column on one line, so every row's name is a single line. */
  @media (min-width: 64rem) { .topic-wall :global(.ply-wall__name) { text-wrap: nowrap; } }
</style>
