---
import Base from "../../layouts/Base.astro";
import Empty from "@dario-loi/polytope/astro/Empty.astro";
import Button from "@dario-loi/polytope/astro/Button.astro";
import Icon from "@dario-loi/polytope/astro/Icon.astro";
import IndexMast from "../../components/IndexMast.astro";
import PubCards from "../../components/PubCards.astro";
import TopicTags from "../../components/TopicTags.astro";
import { entries } from "../../lib/content";
import { topics } from "../../data/topics";
import { papersPage } from "../../lib/schema";
import { hasMath } from "../../lib/tex";
import { person } from "../../site";

const pubs = await entries("publications");
const years = [...new Set(pubs.map((p) => p.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const n = pubs.length;
const description = `Publications by ${person.name}: machine learning papers with abstracts, PDFs, code, and BibTeX, from sheaf networks to test-time adaptation.`;
// The topics a paper lists, in the order of the topic list.
const used = topics.map((t) => t.name).filter((name) => pubs.some((p) => p.data.topics.includes(name)));
---
<Base title="Publications" description={description} current="Publications" schema={[papersPage(pubs, description)]} math={hasMath(...pubs.map((p) => p.data.tldr))} crumbs={[{ name: person.name, href: "/" }, { name: "Publications", href: "/publications/" }]}>
  <IndexMast title="Publications" />
  <div class="ply-container">
    {n === 0 ? (
      <Empty title="No papers listed yet">
        <Button href={person.profiles.scholar} variant="secondary"><Icon name="external" />Google Scholar</Button>
      </Empty>
    ) : (
      <>
      {used.length > 0 && (
        <nav class="pub-topics" aria-label="Topics">
          <p class="pub-topics__lead"><a href="/publications/topics/" data-track="open-topic" data-track-placement="publications" data-track-label="all">Browse by topic<Icon name="arrow-right" /></a></p>
          <TopicTags names={used} placement="publications" />
        </nav>
      )}
      <div class="pub-wall">
        {years.map((y) => (
          <section class="pub-wall__year" aria-labelledby={`y-${y}`}>
            <h2 class="pub-wall__label" id={`y-${y}`}>{y}</h2>
            <PubCards pubs={pubs.filter((p) => p.data.date.getUTCFullYear() === y)} lead={pubs[0].id} placement="publications" />
          </section>
        ))}
      </div>
      </>
    )}
  </div>
</Base>
<style>
  .pub-wall { padding-top: var(--ply-space-5); display: grid; gap: var(--ply-space-6); }
  .pub-wall__year { display: grid; gap: var(--ply-space-5); }
  .pub-wall__year + .pub-wall__year { border-top: var(--ply-border-rule) solid var(--ply-color-rule-strong); padding-top: var(--ply-space-5); }
  .pub-wall__label { font-size: var(--ply-size-3xl); line-height: 1; font-variant-numeric: tabular-nums; }
  @media (min-width: 64rem) {
    .pub-wall__year { grid-template-columns: var(--ply-layout-toc) minmax(0, 1fr); gap: var(--ply-space-6); align-items: start; }
  }
  /* The topics row starts on the cards' edge, so the page has two edges: the title and the years
     at the start, everything they label one column in. Seven tags, set with tight padding, need
     about 84rem to keep to one line there; below that the row starts at the title's edge. */
  @media (min-width: 84rem) {
    .pub-topics { padding-inline-start: calc(var(--ply-layout-toc) + var(--ply-space-6)); }
    .pub-topics :global(.topic-tags) { column-gap: var(--ply-space-1); }
    .pub-topics :global(a.topic-tag) { padding-inline: 0.4rem; }
  }
  .pub-topics { padding-top: var(--ply-space-4); display: grid; gap: var(--ply-space-2); }
  .pub-topics__lead { font-size: var(--ply-size-xs); font-weight: var(--ply-weight-bold); }
  .pub-topics__lead a { display: inline-flex; align-items: center; gap: 0.4em; min-height: 1.5rem; }
  @media (pointer: coarse) { .pub-topics__lead a { min-height: 2.75rem; } }
</style>
