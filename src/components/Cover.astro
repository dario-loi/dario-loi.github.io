---
// An entry's cover picture. A light screenshot that would glare on a dark page can bring a dark
// twin (`dark`, the entry's coverDark): the page shows the one for the theme in use, the
// switch's or else the system's (see .theme-light-only in Base), and prints the light one. The
// browser may fetch both. Do not set display on a cover's img: Polytope's reset makes it a
// block already, and a display rule that outranks Base's would show both twins.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Complex from "@dario-loi/polytope/astro/Complex.astro";
import { pictureFormats } from "../lib/content";

interface Props {
  /** Absent for an entry without a cover: the panel then holds only its complex. Astro counts a
   *  conditional `slot="figure"` as filled even when it renders nothing, so Card would never draw
   *  its own complex; pass this component always, with or without a src. */
  src?: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  /** Seeds the complex drawn under the picture; the card's own (seedOf(id)) so a missing picture
   *  leaves the same complex the card draws without a cover. Only drawn when given, and only
   *  inside a positioned panel. */
  seed?: number;
}
const { src, dark, class: className, seed, ...rest } = Astro.props;
// A picture that fails to load is hidden, so the browser's broken-image icon never covers the complex.
const failed = "this.style.visibility='hidden'";
---
{/* The panel's own complex, under the picture: a picture that is slow, missing, or failed leaves it
    instead of a black void, and the loaded picture covers it. It is server-rendered, so it needs
    no script. The parent panel must be positioned (a card's panel is). */}
{seed !== undefined && <div class="cover-fallback" aria-hidden="true"><Complex seed={seed} points={28} radius={0.17} controls={false} label="A Vietoris-Rips complex" id={`cx-cover-${seed}`} /></div>}
{src && <Picture {...pictureFormats} {...rest} src={src} class:list={[className, dark && "theme-light-only"]} onerror={failed} />}
{src && dark && <Picture {...pictureFormats} {...rest} loading="lazy" fetchpriority="auto" src={dark} class:list={[className, "theme-dark-only"]} onerror={failed} />}
<style is:global>
  .ply-panel:has(> .cover-fallback) { position: relative; }
  .cover-fallback { position: absolute; inset: 0; }
  .cover-fallback .ply-complex-wrap, .cover-fallback .ply-complex { height: 100%; }
  /* The picture is positioned so it paints over the fallback; an opaque picture hides it. */
  .cover-fallback ~ picture, .cover-fallback ~ picture img { position: relative; }
</style>
