---
// An entry's cover picture. A light screenshot that would glare on a dark page can bring a dark
// twin (`dark`, the entry's coverDark): the page shows the one for the theme in use, the
// switch's or else the system's (see .theme-light-only in Base), and prints the light one. The
// browser may fetch both. Do not set display on a cover's img: Polytope's reset makes it a
// block already, and a display rule that outranks Base's would show both twins.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { pictureFormats } from "../lib/content";

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}
const { src, dark, class: className, ...rest } = Astro.props;
---
<Picture {...pictureFormats} {...rest} src={src} class:list={[className, dark && "theme-light-only"]} />
{dark && <Picture {...pictureFormats} {...rest} src={dark} class:list={[className, "theme-dark-only"]} />}
