---
// The mast of a list page: the title with its tomato full stop and an optional lede.
import Mast from "@dario-loi/polytope/astro/Mast.astro";
interface Props { title: string; lede?: string }
const { title, lede } = Astro.props;
---
<Mast title={title} lede={lede} compact />
<hr class="ply-rule" />
<style is:global>
  /* A list page's lede runs as wide as a title line before it wraps, so a sentence a little
     longer than the reading measure does not leave one word on a second line. */
  .ply-mast--compact .ply-mast__lede { max-width: 52rem; text-wrap: balance; }
  /* With enlarged text on a narrow window the title's floor size can outgrow its box; it breaks
     inside the word then, and at 100% size it fits and nothing changes. */
  @media (max-width: 30rem) { .ply-mast__title, .ply-mast__title .ply-nowrap { white-space: normal; overflow-wrap: anywhere; } }
</style>
