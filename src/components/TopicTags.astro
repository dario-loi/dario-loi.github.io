---
// A row of topic tags. Each links to the topic's list of papers; the current topic, on its own
// page, is the filled one. Polytope's Tag draws the link, this adds the topic's address and
// the analytics attributes.
import Tag from "@dario-loi/polytope/astro/Tag.astro";
import { topicOf, topicPath } from "../data/topics";
interface Props { names: string[]; current?: string; label?: string; placement: string; class?: string }
const { names, current, label = "Topics", placement, class: className } = Astro.props;
---
<ul class:list={["ply-tag-list", className]} role="list" aria-label={label}>
  {names.map((n) => (
    <li>
      <Tag href={topicPath(topicOf(n))} rel="tag" current={n === current} data-track="open-topic" data-track-placement={placement} data-track-label={topicOf(n).slug}>{n}</Tag>
    </li>
  ))}
</ul>
