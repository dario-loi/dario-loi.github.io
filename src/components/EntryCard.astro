---
// A preview of one entry (post, paper, or project), hung like an exhibit: a black panel
// holding the entry's cover figure, or else a Vietoris-Rips complex seeded from the entry's
// id so every entry draws its own. Under it, the title (the one link a keyboard reaches),
// a meta line, and a summary. The panel is a second, pointer-only way into the same page.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Complex from "@dario-loi/polytope/astro/Complex.astro";
import { cardComplex, pictureFormats, seedOf } from "../lib/content";

interface Props {
  href: string;
  title: string;
  id: string;
  /** Plain text; a "summary" slot replaces it with markup, such as a TL;DR with math. */
  summary?: string;
  /** Short facts under the title, such as a venue and a date. */
  meta?: string[];
  /** A wall label on the panel, such as "Paper" or "Draft". */
  kind?: string;
  tags?: string[];
  /** Decorative here: the title names the entry, so the panel image carries no alt text. */
  cover?: ImageMetadata;
  /** "lead" spans the row and sets the panel beside the text on wide screens. */
  size?: "lead" | "regular";
  /** Heading level of the title in its page's outline. */
  level?: 2 | 3;
  draft?: boolean;
  /** Event name when the card's link is followed, such as "open-post". */
  track?: string;
  placement?: string;
}
const { href, title, id, summary, meta = [], kind, tags = [], cover, size = "regular", level = 3, draft = false, track, placement } = Astro.props;
const seed = seedOf(id);
const { points, radius } = cardComplex(seed);
const H = `h${level}` as "h3";
---
<article class:list={["entry-card", size === "lead" && "entry-card--lead"]}>
  <a class="entry-card__panel" href={href} tabindex="-1" aria-hidden="true" data-surface="panel">
    {cover ? (
      <Picture {...pictureFormats} class="entry-card__cover" src={cover} alt="" widths={[480, 800, 1200]} sizes={size === "lead" ? "(min-width: 64rem) 50vw, 100vw" : "(min-width: 64rem) 30vw, 100vw"} />
    ) : (
      <Complex points={points} radius={radius} seed={seed} controls={false} label={title} id={`cx-${id.replace(/[^a-z0-9-]/gi, "-")}`} />
    )}
    {(kind || draft) && (
      <span class="entry-card__labels">
        {draft && <span class="ply-label entry-card__draft">Draft</span>}
        {kind && <span class="ply-label">{kind}</span>}
      </span>
    )}
  </a>
  <div class="entry-card__body">
    <H class="entry-card__title"><a href={href} data-track={track} data-track-placement={placement} data-track-label={id}>{title}</a></H>
    {meta.length > 0 && <p class="entry-card__meta">{meta.map((m) => <span>{m}</span>)}</p>}
    {Astro.slots.has("summary") ? <p class="entry-card__summary"><slot name="summary" /></p> : summary && <p class="entry-card__summary">{summary}</p>}
    {tags.length > 0 && (
      <ul class="tag-list" role="list" aria-label="Topics">
        {tags.map((t) => <li class="ply-tag">{t}</li>)}
      </ul>
    )}
    <slot />
  </div>
</article>
<style is:global>
  .entry-card { display: grid; grid-template-rows: auto 1fr; gap: var(--ply-space-4); align-content: start; min-width: 0; }
  .entry-card__panel { position: relative; display: block; background: var(--ply-color-panel); aspect-ratio: 100 / 56; overflow: hidden; text-decoration: none; }
  .entry-card__panel .ply-complex-wrap, .entry-card__panel .ply-complex { height: 100%; }
  .entry-card__cover { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* A hairline frame, so a light screenshot keeps its edge on the white wall. */
  .entry-card__panel:has(.entry-card__cover)::after { content: ""; position: absolute; inset: 0; border: var(--ply-border-hair) solid var(--ply-color-rule); pointer-events: none; }
  .entry-card__labels { position: absolute; inset-block-start: var(--ply-space-3); inset-inline-start: var(--ply-space-3); display: flex; gap: var(--ply-space-2); pointer-events: none; }
  /* Labels sit over figures that are often white, so they carry their own ground: a soft
     mustard fill with a mustard edge and black text (Polytope's highlight, black on mustard),
     and the dev-only Draft label in exhibit black with a chalk edge. */
  .entry-card__labels .ply-label { background: var(--ply-mustard-100); color: var(--ply-ink-950); outline: 1.5px solid var(--ply-mustard-500); outline-offset: -1.5px; }
  .entry-card__labels .entry-card__draft { background: var(--ply-ink-950); color: var(--ply-ink-50); outline: 1.5px solid var(--ply-ink-50); outline-offset: -1.5px; }
  .entry-card__body { display: grid; gap: var(--ply-space-2); align-content: start; }
  .entry-card__title { font-family: var(--ply-font-text); font-size: var(--ply-size-lg); font-weight: var(--ply-weight-bold); line-height: 1.25; letter-spacing: -0.01em; text-wrap: balance; }
  .entry-card__title a { color: var(--ply-color-text); font-weight: inherit; text-decoration-color: var(--ply-color-rule); }
  .entry-card:hover .entry-card__title a { text-decoration-color: var(--ply-color-accent); }
  .entry-card__meta { display: flex; flex-wrap: wrap; gap: 0 var(--ply-space-3); font-size: var(--ply-size-sm); font-weight: var(--ply-weight-semibold); color: var(--ply-color-text-muted); font-variant-numeric: tabular-nums; }
  .entry-card__meta span:first-child { color: var(--ply-color-text); }
  .entry-card__summary { font-size: var(--ply-size-ui); line-height: var(--ply-leading-normal); color: var(--ply-color-text-muted); max-width: 40rem; }
  @media (min-width: 64rem) {
    .entry-card--lead { grid-column: 1 / -1; grid-template-rows: none; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--ply-space-6); align-items: start; }
    .entry-card--lead .entry-card__title { font-family: var(--ply-font-display); font-weight: var(--ply-weight-regular); font-size: var(--ply-size-2xl); line-height: 1.1; }
    .entry-card--lead .entry-card__summary { font-size: var(--ply-size-md); }
  }
</style>
