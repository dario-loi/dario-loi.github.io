---
// The panel's fallback complex under a cover picture: the same drawing as Polytope's Complex
// (same generator, same classes, so the same pixels), but a plain element with no custom-element
// script behind it. It sits under a picture and takes no input, so upgrading it would only spend
// main-thread time on every card. Used only when a picture covers it; a panel with no picture
// keeps the live Complex.
interface Props { seed: number; points?: number; radius?: number }
const { seed, points = 28, radius = 0.17 } = Astro.props;

let s = seed >>> 0 || 1;
const rand = () => ((s = (s * 1664525 + 1013904223) >>> 0) / 4294967296);
const cols = Math.ceil(Math.sqrt(points * 1.8)), rows = Math.ceil(points / cols);
const pts = Array.from({ length: points }, (_, i) => {
  const c = i % cols, r = Math.floor(i / cols);
  return [6 + ((c + 0.15 + rand() * 0.7) / cols) * 88, 5 + ((r + 0.15 + rand() * 0.7) / rows) * 46];
});
const R = radius * 100;
const adj = pts.map(() => new Set<number>());
const edges: [number, number][] = [];
for (let i = 0; i < points; i++) for (let j = i + 1; j < points; j++) {
  if (Math.hypot(pts[i][0] - pts[j][0], pts[i][1] - pts[j][1]) <= R) { edges.push([i, j]); adj[i].add(j); adj[j].add(i); }
}
const tris: [number, number, number][] = [];
for (const [i, j] of edges) for (const k of adj[i]) if (k > j && adj[j].has(k)) tris.push([i, j, k]);
---
<div class="ply-complex-wrap">
  <div class="ply-complex">
    <svg class="ply-complex__static" viewBox="0 0 100 56" aria-hidden="true">
      <g>{tris.map(([a, b, c]) => <polygon class="ply-complex__tri" points={`${pts[a]} ${pts[b]} ${pts[c]}`} />)}</g>
      <g>{edges.map(([a, b]) => <line class="ply-complex__edge" x1={pts[a][0]} y1={pts[a][1]} x2={pts[b][0]} y2={pts[b][1]} />)}</g>
      <g>{pts.map(([x, y]) => <circle class="ply-complex__pt" cx={x} cy={y} r="0.9" />)}</g>
    </svg>
  </div>
</div>
