---
// Coarse to fine: a Gaussian learning-rate schedule sweeping over the layers of an implicit neural
// representation, and a toy 1-D signal built band by band under it. The paper specifies a Gaussian
// over the layers, centered on one layer that moves on, and 400 inversion steps; the number of
// layers shown, the width, the smooth sweep, and the band frequencies and amplitudes are ours.
import Model from "./Model.astro";
import Slider from "@dario-loi/polytope/astro/Slider.astro";
import Readout from "@dario-loi/polytope/astro/Readout.astro";
interface Props { draft?: boolean }
const { draft = false } = Astro.props;

const L = 8;          // layers shown
const T = 400;        // inversion steps (paper, main setting)
const SIGMA = 0.9;    // Gaussian width in layers
const FREQ = [1, 2, 3, 5, 8, 12, 17, 23]; // whole cycles over the window, one band per layer
const AMP = [1, 0.8, 0.6, 0.45, 0.33, 0.24, 0.17, 0.12];
const N = 400;        // samples along the signal
const DEFAULT = 150;

// Multiplier of layer i at step s: Gaussian around the center c(s), swept from layer 0 to L - 1.
const mult = (i: number, s: number) => Math.exp(-((i - ((L - 1) * s) / T) ** 2) / (2 * SIGMA ** 2));
// Progress of layer i after t steps, 0..1: learning rate summed so far over its total across the run.
const total = Array.from({ length: L }, (_, i) => { let q = 0; for (let k = 0; k < T; k++) q += mult(i, k); return q; });
const prog = (t: number) => Array.from({ length: L }, (_, i) => { let q = 0; for (let k = 0; k < t; k++) q += mult(i, k); return q / total[i]; });

const X0 = 6, X1 = 94, MID = 43, SC = 3.6;
const sig = (w: number[]) => Array.from({ length: N + 1 }, (_, n) => {
  let y = 0; for (let b = 0; b < L; b++) y += w[b] * AMP[b] * Math.sin(2 * Math.PI * FREQ[b] * n / N);
  return `${n ? "L" : "M"}${(X0 + (X1 - X0) * n / N).toFixed(2)} ${(MID - SC * y).toFixed(2)}`;
}).join("");
const state = (t: number) => {
  const p = prog(t);
  const m = Array.from({ length: L }, (_, i) => mult(i, t));
  const peak = m.indexOf(Math.max(...m));
  const energy = p.reduce((q, v, b) => q + v * v * AMP[b] ** 2, 0) / AMP.reduce((q, a) => q + a * a, 0);
  return { p, m, peak, energy };
};
const s = state(DEFAULT);
const BASE = 22, BH = 17, BW = 7, BC = 11.5, PITCH = 11, bx = (i: number) => BC + i * PITCH - BW / 2; // bar centers run symmetrically about 50, 11.5 to 88.5
const target = sig(AMP.map(() => 1));
const pct = (e: number) => `${Math.round(e * 100)}%`;
---
<Model name="clip-frequency" title="Coarse to fine" draft={draft} firstRun>
  <svg viewBox="0 0 100 56" role="img" aria-label={`Eight bars for the layers of an implicit neural representation, low to high frequency, with the learning rate peaked on layer ${s.peak + 1}; below, a toy signal drawn up to the bands that the layers have fitted so far, at step ${DEFAULT} of ${T}.`}>
    <g data-bars>
      {s.m.map((m, i) => <rect class={i === s.peak ? "m-move" : "m-chalk-fill"} x={bx(i)} y={BASE - BH * m} width={BW} height={BH * m} />)}
    </g>
    <line class="m-rule" x1="4" y1={BASE + 0.8} x2="96" y2={BASE + 0.8} stroke-width="0.4" />
    <text class="m-text-quiet" x="4" y="27" font-size="3.6">low</text>
    <text class="m-text-quiet" x="96" y="27" font-size="3.6" text-anchor="end">high</text>
    <path class="m-quiet" d={target} stroke-width="0.4" />
    <path class="m-chalk" d={sig(s.p)} stroke-width="0.6" data-line />
  </svg>
  <Fragment slot="controls">
    <div class="model__axis" style={`--x0:${BC / 100};--x1:${(BC + (L - 1) * PITCH) / 100}`}><Slider label="Optimization step" name="clip-step" min={0} max={T} step={1} value={DEFAULT} /></div>
    <Readout label="Schedule and signal" items={[{ label: "Peak layer", value: `${s.peak + 1} of ${L}` }, { label: "Signal energy fitted", value: pct(s.energy) }]} />
  </Fragment>
  <Fragment slot="caption">The learning rate peaks on one layer of the implicit neural representation at a time, sweeping from low to high frequencies, so layout and color settle before fine texture.</Fragment>
</Model>
<script>
  import { firstRun, easeOut } from "./firstRun";
  const L = 8, T = 400, SIGMA = 0.9, N = 400, X0 = 6, X1 = 94, MID = 43, SC = 3.6, BASE = 22, BH = 17;
  const FREQ = [1, 2, 3, 5, 8, 12, 17, 23], AMP = [1, 0.8, 0.6, 0.45, 0.33, 0.24, 0.17, 0.12];
  const mult = (i: number, s: number) => Math.exp(-((i - ((L - 1) * s) / T) ** 2) / (2 * SIGMA ** 2));
  // cum[i][t] / cum[i][T] is layer i's progress after t steps.
  const cum = Array.from({ length: L }, (_, i) => { const a = new Float64Array(T + 1); for (let k = 0; k < T; k++) a[k + 1] = a[k] + mult(i, k); return a; });
  const e2 = AMP.reduce((q, a) => q + a * a, 0);
  const root = document.querySelector<HTMLElement>('[data-model="clip-frequency"]');
  const input = root?.querySelector<HTMLInputElement>('input[type="range"]');
  const line = root?.querySelector("[data-line]");
  const rects = Array.from(root?.querySelectorAll("[data-bars] rect") ?? []);
  const dds = root?.querySelectorAll(".ply-readout dd");
  let last = -1;
  const set = (el: Element | null | undefined, name: string, v: string) => { if (el && el.getAttribute(name) !== v) el.setAttribute(name, v); };
  function draw(t: number, say = true) {
    if (t === last || !input || !line) return;
    last = t;
    const m = Array.from({ length: L }, (_, i) => mult(i, t));
    const peak = m.indexOf(Math.max(...m));
    const p = cum.map((a) => a[t] / a[T]);
    let d = "";
    for (let n = 0; n <= N; n++) {
      let y = 0; for (let b = 0; b < L; b++) y += p[b] * AMP[b] * Math.sin(2 * Math.PI * FREQ[b] * n / N);
      d += `${n ? "L" : "M"}${(X0 + (X1 - X0) * n / N).toFixed(2)} ${(MID - SC * y).toFixed(2)}`;
    }
    set(line, "d", d);
    rects.forEach((r, i) => {
      set(r, "y", (BASE - BH * m[i]).toFixed(2));
      set(r, "height", (BH * m[i]).toFixed(2));
      set(r, "class", i === peak ? "m-move" : "m-chalk-fill");
    });
    const energy = Math.round(100 * p.reduce((q, v, b) => q + v * v * AMP[b] ** 2, 0) / e2);
    const a = `${peak + 1} of ${L}`, b = `${energy}%`;
    if (dds?.[0] && dds[0].textContent !== a) dds[0].textContent = a;
    if (dds?.[1] && dds[1].textContent !== b) dds[1].textContent = b;
    if (!say) return;
    // Polytope's slider script sets aria-valuetext too, after this handler; say it in words last.
    requestAnimationFrame(() => input.setAttribute("aria-valuetext", `Step ${t} of ${T}, learning rate peaked on layer ${a}, ${b} of the signal's energy fitted`));
  }
  input?.addEventListener("input", () => draw(Number(input.value)));
  if (input) draw(Number(input.value));

  // First view: the optimization step runs from 0 to its default, the learning-rate peak sweeping
  // from the low layers up while the signal builds band by band.
  if (root && input) {
    const rest = Number(input.value), out = root.querySelector("[data-ply-slider] output");
    const show = (t: number) => { input.value = String(t); const v = String(t); if (out && out.textContent !== v) out.textContent = v; draw(t, false); };
    firstRun(root, {
      duration: 2.4,
      start() { input.removeAttribute("aria-valuetext"); show(0); },
      frame(p) { show(Math.round(rest * easeOut(p))); },
      end(cancelled) {
        if (!cancelled) show(rest);
        last = -1;
        draw(Number(input.value));
      },
    });
  }
</script>
