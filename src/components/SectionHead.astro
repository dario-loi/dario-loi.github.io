---
// A section heading with an optional way onward ("All publications") on the same line.
// With `fragment` (the home page), the heading also opens on a 3px rule that leads with a short
// tomato segment and steps up in pixels at its end, and carries a small static Vietoris-Rips
// fragment, seeded from the section's name, before the title.
import Icon from "@dario-loi/polytope/astro/Icon.astro";
import VrMark from "./VrMark.astro";
import { seedOf } from "../lib/content";
interface Props { title: string; id?: string; more?: { label: string; href: string }; fragment?: string }
const { title, id, more, fragment } = Astro.props;
---
{fragment && <div class="sec-rule" aria-hidden="true"></div>}
<div class:list={["section-head", fragment && "section-head--marked"]}>
  {fragment
    ? <div class="section-head__title"><VrMark seed={seedOf(fragment)} /><h2 id={id}>{title}</h2></div>
    : <h2 id={id}>{title}</h2>}
  {more && <a class="section-head__more ply-target" href={more.href}>{more.label}<Icon name="arrow-right" /></a>}
</div>
<style is:global>
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--ply-space-2) var(--ply-space-5); margin-bottom: var(--ply-space-6); }
  .section-head--marked { align-items: center; margin-top: var(--ply-space-4); }
  .section-head__title { display: flex; align-items: center; gap: var(--ply-space-4); min-width: 0; }
  .section-head h2 { overflow-wrap: anywhere; min-width: 0; }
  .section-head__title h2 { margin: 0; }
  /* The section's rule: Base.astro's pixel stair at its end, and here a tomato lead, a small
     mark that starts the line and the eye, as the full stop ends the headline. */
  .sec-rule {
    height: 0.75rem; margin-top: -0.5625rem;
    background:
      linear-gradient(var(--ply-color-accent), var(--ply-color-accent)) left bottom / 3.5rem 3px no-repeat,
      var(--site-stair),
      linear-gradient(var(--ply-color-rule-strong), var(--ply-color-rule-strong)) left bottom / 100% 3px no-repeat;
  }
  @media (max-width: 30rem) { .section-head__title .site-fragment { width: 4rem; } .section-head__title { gap: var(--ply-space-3); } }
  /* On the narrowest phones the mark would leave "publications" too little room, so it steps aside. */
  @media (max-width: 22.5rem) { .section-head__title .site-fragment { display: none; } .section-head__title h2 { overflow-wrap: anywhere; } }
  /* 24px tall, in Polytope's components layer so .ply-target (a utility) raises it to 44px
     under a finger. The layer order is restated so this sheet never sets it first. */
  @layer ply.reset, ply.base, ply.layout, ply.components, ply.utilities;
  @layer ply.components {
    .section-head__more { display: inline-flex; align-items: center; gap: var(--ply-space-2); min-height: 1.5rem; font-size: var(--ply-size-ui); }
  }
  .section-head__more .ply-icon { transition: transform var(--ply-duration-fast) var(--ply-ease-out); }
  .section-head__more:hover .ply-icon { transform: translateX(0.2em); }
</style>
