---
// A section heading with an optional way onward ("All publications") on the same line.
import Icon from "@dario-loi/polytope/astro/Icon.astro";
interface Props { title: string; id?: string; more?: { label: string; href: string } }
const { title, id, more } = Astro.props;
---
<div class="section-head">
  <h2 id={id}>{title}</h2>
  {more && <a class="section-head__more" href={more.href}>{more.label}<Icon name="arrow-right" /></a>}
</div>
<style is:global>
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--ply-space-2) var(--ply-space-5); margin-bottom: var(--ply-space-6); }
  .section-head__more { display: inline-flex; align-items: center; gap: var(--ply-space-2); min-height: 1.5rem; font-size: var(--ply-size-ui); }
  .section-head__more .ply-icon { transition: transform var(--ply-duration-fast) var(--ply-ease-out); }
  .section-head__more:hover .ply-icon { transform: translateX(0.2em); }
  @media (pointer: coarse) { .section-head__more { min-height: 2.75rem; } }
</style>
