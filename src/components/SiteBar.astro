---
// The site's top bar: Polytope's TopBar markup with the wordmark's tomato full stop, and
// the CV tab tracked like every other CV link. Tabs show where they fit and fold into the
// chapter menu where they do not (polytope js/topbar.js).
import Icon from "@dario-loi/polytope/astro/Icon.astro";
import ThemeToggle from "@dario-loi/polytope/astro/ThemeToggle.astro";
import { person, siteMeta } from "../site";

export interface Tab { label: string; href: string; current?: boolean; track?: string }
interface Props { tabs: Tab[] }
const { tabs } = Astro.props;
const home = Astro.url.pathname === "/";
---
<header class="ply-topbar">
  <div class="ply-container ply-topbar__inner">
    {home
      ? (
        <a class="ply-wordmark site-emblem" href="/" aria-label={`${person.name}, home`}>
          <span class="site-emblem__ghost" aria-hidden="true">{person.name}.</span>
          <svg class="site-emblem__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect width="32" height="32" fill="var(--ply-color-panel)" />
            <path d="M6 23.5 12.5 8.5 20 23.5Z" fill="var(--ply-color-note)" fill-opacity=".6" />
            <g fill="none" stroke="var(--ply-color-panel-text)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 23.5 12.5 8.5 20 23.5Z" /><path d="M20 23.5 26 10.5" /></g>
            <g fill="var(--ply-color-panel-text)"><circle cx="6" cy="23.5" r="2.5" /><circle cx="20" cy="23.5" r="2.5" /><circle cx="26" cy="10.5" r="2.5" /></g>
            <circle cx="12.5" cy="8.5" r="2.5" fill="var(--ply-color-accent)" />
          </svg>
        </a>
      )
      : <a class="ply-wordmark" href="/">{person.name}<span class="ply-wordmark__stop" aria-hidden="true">.</span></a>}
    <nav class="ply-topbar__links" aria-label="Sections">
      {tabs.map((t) => (
        <a class="ply-tab" href={t.href} aria-current={t.current ? "page" : undefined} data-track={t.track} data-track-placement={t.track && "topbar"}>{t.label}</a>
      ))}
    </nav>
    <div class="ply-topbar__tools">
      <a class="ply-button ply-button--ghost ply-button--icon ply-button--sm ply-hide-narrow" href={siteMeta.repo} aria-label="Source of this site on GitHub"><Icon name="code" /></a>
      <ThemeToggle />
      <details class="ply-menu ply-menu--chapters">
        <summary class="ply-button ply-button--secondary ply-button--sm"><Icon name="menu" /><span class="ply-menu__word">Menu</span></summary>
        <nav class="ply-menu__panel" aria-label="Sections menu">
          {tabs.map((t) => (
            <a class="ply-tab" href={t.href} aria-current={t.current ? "page" : undefined} data-track={t.track} data-track-placement={t.track && "menu"}>{t.label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
<script>import "@dario-loi/polytope/js/topbar.js";</script>
<style is:global>
  /* Enlarged text on a narrow window: once the tabs have folded into the menu, the bar's parts may
     wrap to a second row instead of running past the edge. Only then: while the tabs show, a wrap
     would give them a row of their own, topbar.js would see them fit, and a phone would get the
     tabs and the tools on rows of their own. Without the script (no data-ply-tabs), Polytope's
     breakpoint shows the menu. Nothing changes while everything fits on one line. */
  @media (max-width: 30rem) {
    .ply-topbar:is([data-ply-tabs="menu"], :not([data-ply-tabs])) .ply-topbar__inner { flex-wrap: wrap; }
    .ply-topbar .ply-wordmark { flex: 0 1 auto; min-width: 0; white-space: normal; overflow-wrap: anywhere; }
    .ply-topbar__tools { flex: 0 1 auto; flex-wrap: wrap; justify-content: flex-end; }
  }
  /* The home page's bar carries the emblem where inner pages carry the wordmark (their folio). The
     link holds the wordmark's own box, set invisibly, so the tabs sit exactly where they do on every
     other page; the emblem is the favicon's object, drawn at its left edge. */
  .site-emblem { position: relative; display: inline-block; }
  .site-emblem__ghost { visibility: hidden; }
  .site-emblem__mark { position: absolute; inset-inline-start: 0; top: 50%; height: 1.5em; width: 1.5em; transform: translateY(-50%); }
  .site-emblem:focus-visible .site-emblem__mark { outline: none; }
</style>
